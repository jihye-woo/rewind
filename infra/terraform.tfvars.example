# 이 파일을 terraform.tfvars 로 복사한 뒤 값을 바꾼다. terraform.tfvars 는 git 에 올라가지 않는다.

# 앱 주소로 쓸 도메인과, 그 도메인이 속한 Route 53 호스팅 영역
domain_name = "rewind.example.com"
zone_name   = "example.com"

# 도메인 아래 이 서비스의 경로. 비우면 도메인 루트를 쓴다 → https://example.com/english/
base_path = "english"

# 기본값을 바꾸고 싶을 때만
# region = "ap-northeast-2"
# name   = "rewind"

# 앱 접속 키를 직접 정하려면 (12자 이상, 영문·숫자·._~-). 비워 두면 무작위로 만든다.
# 이 파일 대신 환경 변수로 넘겨도 된다: export TF_VAR_app_key='...'
# app_key = ""

# 키 없이도 읽기 전용으로 보여 줄지 (기본 true)
# public_read = true
